<header><p class="eyebrow">{{eyebrow}}</p><h2>{{title}}</h2></header><div class="scene-layout">{{#if scene.steps}}<div class="scene" data-scene="{{id}}"><div class="scene-fallback scene-fallback-steps"><p>{{scene.caption}}</p><ol class="scene-steps">{{#each scene.steps}}<li><strong>{{title}}</strong> {{detail}}</li>{{/each}}</ol></div></div><aside class="scene-detail"><p class="lead">{{body}}</p><div class="scene-detail-head"><p class="step-count"></p><div class="step-controls"><button data-scene-step="-1" data-for="{{id}}" aria-label="Paso anterior">←</button><button data-scene-step="1" data-for="{{id}}" aria-label="Paso siguiente">→</button></div></div><h3></h3><p class="step-description"></p><p class="caption">{{scene.caption}}</p><p class="interaction-hint">Arrastra para girar. Los botones recorren los pasos.</p><button class="scene-toggle" data-for="{{id}}" aria-pressed="true">Pausar giro</button></aside>{{else}}<div class="scene" data-scene="{{id}}" role="img" aria-label="{{scene.caption}}"><p class="scene-fallback">{{scene.caption}}</p></div><aside><p class="lead">{{body}}</p><p class="caption">{{scene.caption}}</p><p class="interaction-hint">Arrastra para girar. Usa la rueda para acercarte.</p><button class="scene-toggle" data-for="{{id}}" aria-pressed="true">Pausar giro</button></aside>{{/if}}</div>
